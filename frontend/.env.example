# Copy this file to .env to point the frontend at the Laravel backend.
# (If you're still running the Node backend instead, leave this file
# absent — api.ts falls back to http://localhost:4000/api on its own.)

VITE_API_URL=http://localhost:8000/api

# Must match the Laravel backend's REVERB_* values in backend-laravel/.env
VITE_REVERB_APP_KEY=local-reverb-key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
