APP_NAME="Ayeyarwady Grill"
APP_ENV=local
# Generate this with: php artisan key:generate
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

CLIENT_URL=http://localhost:5173

LOG_CHANNEL=stack
LOG_LEVEL=debug

# PostgreSQL connection
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ayeyarwady_grill
DB_USERNAME=postgres
DB_PASSWORD=postgres

SESSION_DRIVER=file
CACHE_STORE=file
# 'sync' runs broadcasts immediately — no queue worker process needed locally
QUEUE_CONNECTION=sync

# Laravel Reverb (WebSocket server) — run `php artisan reverb:start` locally.
# Generate real values with: php artisan reverb:install
REVERB_APP_ID=ayeyarwady-grill
REVERB_APP_KEY=local-reverb-key
REVERB_APP_SECRET=local-reverb-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

BROADCAST_CONNECTION=reverb
