/vendor
/node_modules
/public/hot
/public/storage
/storage/*.key
# Scratch drop-folder for importing food photos — see its README. The
# processed result lands in storage/app/public/menu-item-images/ (already
# tracked, same as every other uploaded menu photo), so the raw originals
# here don't need to be.
/storage/app/food-photos-inbox/*
!/storage/app/food-photos-inbox/README.md
.env
.env.backup
.env.production
.phpunit.result.cache
Homestead.json
Homestead.yaml
auth.json
npm-debug.log
yarn-error.log
/.fleet
/.idea
/.vscode
.DS_Store

# Runtime files Laravel writes on every machine — never commit these
/storage/logs/*.log
/storage/framework/views/*.php
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitkeep
/storage/framework/sessions/*
!/storage/framework/sessions/.gitkeep
